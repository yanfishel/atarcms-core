# Development defaults for `docker compose up`. A server with Docker: COMPOSE_FILE=compose.production.yaml (see
# compose.production.yaml); without Docker: DB_HOST=127.0.0.1 (see .agents/skills/building-atarcms-sites/references/install.md).
# Docker on Linux: the owner of the site's files (`id -u`, `id -g`), so PHP, composer and bin/atar run as that user.
# Docker Desktop (Windows, macOS): leave empty.
HOST_UID=
HOST_GID=
# APP_ENV=local relaxes the session cookie (no __Host- prefix, no Secure flag) for plain-HTTP requests only.
# In production set APP_ENV=production, APP_DEBUG=false and APP_URL to the public https:// URL of the site root.
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_THEME=default
LOG_LEVEL=debug
DB_HOST=db
DB_PORT=3306
DB_DATABASE=atar
DB_USERNAME=atar
DB_PASSWORD=atar
# Google OAuth client (Google Cloud console → APIs & Services → Credentials → OAuth client ID, type "Web").
# Authorized redirect URI: {APP_URL}/admin/login/google/callback
ATAR_GOOGLE_CLIENT_ID=
ATAR_GOOGLE_CLIENT_SECRET=
# Optional comma-separated Google Workspace domains allowed to sign in.
ATAR_GOOGLE_ALLOWED_DOMAINS=
# Outgoing mail (the contact form); empty: no mail, the messages stay in the admin. With docker compose every mail
# lands in Mailpit (http://localhost:8025): compose.yaml sets MAIL_DSN=smtp://mailpit:1025 while this one is empty.
# In production, for example: MAIL_DSN=smtp://user:password@smtp.example.com:587 and MAIL_FROM=site@example.com.
MAIL_DSN=
MAIL_FROM=site@localhost.test
