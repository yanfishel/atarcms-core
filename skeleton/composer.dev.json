{
    "name": "yanfishel/atarcms",
    "description": "AtarCMS site skeleton",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "yanfishel/atarcms-core": "@dev"
    },
    "repositories": [
        { "type": "path", "url": "..", "options": { "symlink": true } }
    ],
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
