{
    "name": "yanfishel/atarcms-core",
    "description": "Lightweight content management system",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "guzzlehttp/guzzle": "^8.2",
        "intervention/image": "^4.3",
        "league/oauth2-client": "^2.9",
        "league/oauth2-google": "^5.0",
        "nikic/fast-route": "^1.3",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/container": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "symfony/html-sanitizer": "^8.1",
        "symfony/mailer": "^8.1",
        "wamania/php-stemmer": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": { "AtarCms\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "AtarCms\\Tests\\": "tests/", "App\\": "skeleton/src/" }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=2G --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@stan", "@test"]
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    }
}
